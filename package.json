{
  "name": "rembert",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "prisma generate && node prisma/prepare-production-db.js && node prisma/upsert-priority-filters.js --build-sync && next build",
    "dev": "next dev -H 0.0.0.0",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "sync:caterpillar": "node prisma/sync-caterpillar-products.js",
    "sync:priority-filters": "node prisma/upsert-priority-filters.js",
    "sync:inventory": "node prisma/sync-inventory-catalog.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "dev:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:cloudflare:built": "opennextjs-cloudflare populateCache local && wrangler dev --local",
    "verify:local": "npm run catalog:check && npm run check:fitments && npm run lint && npm run build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare:built": "opennextjs-cloudflare deploy",
    "deploy": "npm run build:cloudflare && npm run deploy:cloudflare:built",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "analyze": "ANALYZE=true next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:fitments": "node scripts/validate-fitments.mjs",
    "catalog:import": "node scripts/import-product-batch.mjs",
    "catalog:check": "node scripts/validate-automated-catalog.mjs",
    "check:images": "node scripts/validate-public-image-references.mjs",
    "verify:release": "npm run catalog:check && npm run check:fitments && npm run check:images && npm run lint",
    "optimize:images": "node scripts/optimize-public-images.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "6.12.0",
    "@prisma/client": "6.12.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "html-to-image": "^1.11.13",
    "next": "16.3.0",
    "papaparse": "^5.5.4",
    "pg": "8.16.3",
    "pg-cloudflare": "1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@next/bundle-analyzer": "^16.3.1",
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "wrangler": "^4.125.0"
  }
}
