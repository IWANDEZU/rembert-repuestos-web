{
  "name": "rembert",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "prisma generate && node prisma/prepare-production-db.js && node prisma/upsert-priority-filters.js --build-sync && next build",
    "dev": "next dev -H 0.0.0.0",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "sync:caterpillar": "node prisma/sync-caterpillar-products.js",
    "sync:priority-filters": "node prisma/upsert-priority-filters.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/optimize-worker.mjs && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && node scripts/optimize-worker.mjs && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "html-to-image": "^1.11.13",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "papaparse": "^5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "wrangler": "^4.125.0"
  }
}
