{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare-worker.js",
  "name": "rembert",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "www.rembertrepuestos.com/*",
      "zone_name": "rembertrepuestos.com"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rembert"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "rembert-catalog-imports",
        "binding": "CATALOG_IMPORT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "rembert-catalog-imports",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "rembert-catalog-imports-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "314159",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "314160",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "FAVORITES_RATE_LIMITER",
      "namespace_id": "314161",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "314162",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "ACCOUNT_DELETE_RATE_LIMITER",
      "namespace_id": "314163",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "POS_RATE_LIMITER",
      "namespace_id": "314164",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
