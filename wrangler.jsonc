{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rembert",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rembert"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "314159",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "314160",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "FAVORITES_RATE_LIMITER",
      "namespace_id": "314161",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "314162",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "ACCOUNT_DELETE_RATE_LIMITER",
      "namespace_id": "314163",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "POS_RATE_LIMITER",
      "namespace_id": "314164",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
