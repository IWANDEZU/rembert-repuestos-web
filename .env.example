# Copia este archivo como .env.local para desarrollo; nunca publiques valores reales.
DATABASE_URL=
DATABASE_POSTGRES_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Activar sólo después de aplicar la migración y sincronizar el catálogo.
CATALOG_DATABASE_READS=false
CATALOG_DATABASE_WRITES=false
NEXT_PUBLIC_CATALOG_REALTIME=false
# Secretos exclusivamente de servidor/Worker; nunca usar NEXT_PUBLIC_ ni enviarlos por URL.
CATALOG_WORKER_SECRET=
POS_SYNC_SECRET=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Facebook, Google y GitHub se configuran dentro de Supabase Auth > Providers.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
